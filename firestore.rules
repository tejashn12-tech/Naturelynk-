rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Quote leads submitted by prospective international & domestic buyers
    match /quotes/{quoteId} {
      allow read, write: if true;
    }

    // Export trade categories and product grades (Coffee, Pepper, Cardamom, Turmeric, Ginger, etc.)
    match /exportCategories/{categoryId} {
      allow read, write: if true;
    }

    // Products collection
    match /products/{productId} {
      allow read, write: if true;
    }

    // Trust, regulatory & compliance documents
    match /trustDocs/{docId} {
      allow read, write: if true;
    }

    // Fallback rule for app collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
